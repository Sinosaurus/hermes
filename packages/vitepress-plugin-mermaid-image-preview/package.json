{
  "name": "vitepress-plugin-mermaid-image-preview",
  "version": "0.1.1",
  "description": "Mermaid and image previews for VitePress, with zoom, pan and touch gestures.",
  "keywords": [
    "diagram",
    "image",
    "image-preview",
    "lightbox",
    "markdown",
    "markdown-it",
    "mermaid",
    "pan",
    "preview",
    "touch",
    "vitepress",
    "vitepress-plugin",
    "vue",
    "zoom"
  ],
  "homepage": "https://github.com/Sinosaurus/vitepress-plugin-mermaid-image-preview#readme",
  "bugs": {
    "url": "https://github.com/Sinosaurus/vitepress-plugin-mermaid-image-preview/issues"
  },
  "license": "MIT",
  "author": "Sinosaurus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sinosaurus/vitepress-plugin-mermaid-image-preview.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme.js"
    },
    "./style.css": {
      "types": "./dist/theme/style.d.ts",
      "import": "./dist/style.css"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "demo:dev": "vitepress dev demo",
    "demo:build": "vitepress build demo",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run demo:build",
    "prepack": "npm run check"
  },
  "devDependencies": {
    "@types/markdown-it": "14.1.2",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "happy-dom": "20.14.3",
    "markdown-it": "14.1.1",
    "mermaid": "11.17.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "6.0.2",
    "vite": "8.3.4",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "5.0.4",
    "vue": "3.5.43",
    "vue-tsc": "3.3.13"
  },
  "peerDependencies": {
    "mermaid": "^11.0.0",
    "vitepress": "^1.6.4 || ^2.0.0-0",
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
